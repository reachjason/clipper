#!/usr/bin/env python3
"""Executable wrapper so you can run `./clip ...` or `clip ...` (if on PATH).

If a project virtualenv exists (.venv, where Textual lives), re-exec into it so
the TUI's dependencies are importable.
"""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
_VENV_PY = ROOT / ".venv" / "bin" / "python"
if _VENV_PY.exists() and Path(sys.executable).resolve() != _VENV_PY.resolve():
    os.execv(str(_VENV_PY), [str(_VENV_PY), __file__, *sys.argv[1:]])

sys.path.insert(0, str(ROOT))

from clipper.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
